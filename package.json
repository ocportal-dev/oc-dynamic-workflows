{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-dynamic-workflows",
  "version": "0.1.0",
  "private": false,
  "description": "Dynamic multi-agent workflows for OpenCode v2: an agent authors a small JSON spec, and the plugin validates, plans, and runs it.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "workflow",
    "subagent"
  ],
  "scripts": {
    "build": "tsc",
    "schema": "bun scripts/schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "prepack": "npm run schema && npm run build"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-18743",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.0",
    "typescript": "^5.8.0"
  }
}
